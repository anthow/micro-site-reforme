# Projet site (client public — déjà utilisé par la page d'accueil)
PUBLIC_SUPABASE_URL=https://YOUR_SITE_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_site_anon_or_publishable_key

# Verrou d'indexation. "true" uniquement au GO, et seulement sur le contexte
# Production de l'hébergeur. Toute autre valeur, ou une URL absente, laisse le site en noindex.
PUBLIC_SITE_INDEXABLE=false
# URL canonique de production, https, sans slash final. Ex. https://exemple.org
PUBLIC_SITE_URL=

# Adresse ajoutée en Cci uniquement si le visiteur coche la case (optionnel).
# PUBLIC_CAMPAGNE_EMAIL est visible côté client ; CAMPAGNE_EMAIL reste côté serveur.
PUBLIC_CAMPAGNE_EMAIL=campagne@example.org
# CAMPAGNE_EMAIL=campagne@example.org

# Secret serveur pour enregistrer un clic. Même valeur que le secret Vault clic_ingest_secret.
# Ne jamais le préfixer par PUBLIC_.
CLIC_INGEST_SECRET=

# Mot de passe partagé de /contactez-votre-depute. Serveur uniquement.
# Sans cette valeur, la page reste fermée.
DEPUTE_PAGE_PASSWORD=

# Formulaire de contact. Serveur uniquement, jamais PUBLIC_.
# CONTACT_FORM_SECRET : au moins 32 caractères aléatoires. Obligatoire en production.
# L'envoi part toujours vers communication@interfede.be, via Resend.
# RESEND_API_KEY commence par re_. CONTACT_FROM doit appartenir à un domaine vérifié dans Resend.
# Exemple : Interfédé <communication@interfede.be>
CONTACT_FORM_SECRET=
RESEND_API_KEY=
CONTACT_FROM=
# reCAPTCHA v2 invisible, créé dans l'admin Google. La clé de site est publique.
# Sans ces deux valeurs, le formulaire reste ouvert en local et refuse l'envoi en production.
# Dans l'admin Google, la clé doit autoriser localhost et le domaine public du site.
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google Analytics 4. ID de mesure du flux Web (Admin → Flux de données), format G-XXXXXXXX.
# Sans cette valeur, aucun script analytics n'est chargé.
PUBLIC_GA_MEASUREMENT_ID=
