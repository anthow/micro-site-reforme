# Secrets de l'Edge Function sync-deputes (projet SITE).
# Les définir via : Dashboard > Edge Functions > Secrets
# ou : npx supabase secrets set --env-file supabase/functions/.env --project-ref <SITE_REF>
#
# Ne jamais committer le fichier .env réel.

# URL du projet SOURCE (celui qui contient déjà les députés, lecture seule)
SOURCE_SUPABASE_URL=https://YOUR_SOURCE_PROJECT.supabase.co

# Clé service_role (ou clé en lecture) du projet SOURCE — jamais une clé publique navigateur
SOURCE_SUPABASE_KEY=your_source_service_role_key
